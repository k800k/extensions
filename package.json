{
  "name": "@mangareader/extensions-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "website"],
  "scripts": {
    "check": "node packages/cli/bin/mr-ext.mjs check",
    "test": "node --test packages/cli/test/*.test.mjs packages/paperback-compat/*.test.mjs scripts/*.test.mjs extensions/content/*/tests/*.test.mjs extensions/tracker/*/tests/*.test.mjs",
    "bundle": "node packages/cli/bin/mr-ext.mjs bundle",
    "publish:dry-run": "node packages/cli/bin/mr-ext.mjs publish --dry-run",
    "docs:dev": "npm --workspace @mangareader/extensions-website run dev",
    "docs:check": "npm --workspace @mangareader/extensions-website run typecheck",
    "docs:build": "npm --workspace @mangareader/extensions-website run build",
    "docs:preview": "npm --workspace @mangareader/extensions-website run preview"
  },
  "engines": { "node": ">=20" },
  "license": "Apache-2.0"
}
