{
  "name": "@mangareader/extensions-monorepo",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@mangareader/extensions-monorepo",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@mangareader/extension-cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@mangareader/extension-sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "packages/cli": {
      "name": "@mangareader/extension-cli",
      "version": "1.0.0",
      "license": "Apache-2.0",
      "bin": {
        "mr-ext": "bin/mr-ext.mjs"
      }
    },
    "packages/sdk": {
      "name": "@mangareader/extension-sdk",
      "version": "1.0.0",
      "license": "Apache-2.0"
    }
  }
}
