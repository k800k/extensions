{
  "id": "MyAnimeList",
  "name": "MyAnimeList",
  "description": "Track manga progress and lists with MyAnimeList.",
  "kind": "tracker",
  "apiVersion": "1.1",
  "version": "1.0.0",
  "language": "multi",
  "languages": ["multi"],
  "contentRating": "SAFE",
  "availability": "available",
  "capabilities": ["authentication", "progress", "trackerCollections", "trackerSearch"],
  "permissions": ["authenticationHandoff", "network", "secureState", "trackerUpdates"],
  "allowedHTTPSHosts": ["api.myanimelist.net", "cdn.myanimelist.net", "myanimelist.net"],
  "authenticationModes": ["oauth2PKCE"],
  "developers": [{ "name": "MangaReader Extension Contributors", "github": "https://github.com/k800k/extensions" }],
  "iconFile": "icon.svg",
  "license": "Apache-2.0"
}
